{
  "domain": "amplifycms.com",
  "onboard": {
    "enableRouting": true
  },
  "mailboxes": [
    {
      "role": "admin",
      "displayName": "Admin"
    },
    {
      "role": "hello",
      "displayName": "Hello",
      "signature": "<p>Amplify CMS</p>"
    },
    {
      "role": "support",
      "displayName": "Support",
      "shared": true,
      "access": [
        {
          "email": "gerard@amplifycms.com",
          "permission": "full_access"
        }
      ],
      "signature": "<p>Amplify CMS Support</p>",
      "folders": [
        {
          "name": "Bugs",
          "color": "#dc2626"
        },
        {
          "name": "Billing",
          "color": "#2563eb"
        }
      ],
      "rules": [
        {
          "field": "title",
          "value": "invoice",
          "folder": "Billing"
        },
        {
          "field": "title",
          "value": "bug",
          "folder": "Bugs"
        }
      ]
    },
    {
      "role": "billing",
      "displayName": "Billing",
      "shared": true
    }
  ],
  "accounts": [
    {
      "username": "gerard",
      "name": "Gerard",
      "role": "admin",
      "preferences": {
        "keyboardShortcuts": true,
        "spamProtection": true
      },
      "mailbox": {
        "signature": "Gerard, Amplify CMS",
        "folders": [
          {
            "name": "Receipts"
          }
        ]
      },
      "templates": [
        {
          "name": "Thanks",
          "body": "Thanks for getting in touch - we will come back to you shortly."
        }
      ],
      "drive": {
        "folders": [
          "Shared"
        ]
      }
    }
  ],
  "routing": [
    {
      "pattern": "*",
      "action": "forward",
      "forwardTo": "gerard.webb@ubuntudesign.com",
      "keepCopy": true,
      "mailbox": "support"
    },
    {
      "pattern": "no-reply",
      "action": "reject",
      "rejectReason": "No such user"
    }
  ],
  "mcpKeys": [
    {
      "name": "agent",
      "mailboxes": [
        "support"
      ],
      "scopes": [
        "mcp:read",
        "mcp:draft",
        "mcp:request-send"
      ]
    }
  ]
}
