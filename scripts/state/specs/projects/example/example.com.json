{
  "domain": "example.com",
  "onboard": {
    "enableRouting": true,
    "replaceMxRecords": false
  },
  "mailboxes": [
    {
      "role": "office",
      "displayName": "Office"
    },
    {
      "role": "admin",
      "displayName": "Admin"
    },
    {
      "role": "events",
      "displayName": "Events",
      "shared": true,
      "access": [
        {
          "email": "sam@example.com",
          "permission": "full_access"
        }
      ]
    },
    {
      "role": "support",
      "displayName": "Support",
      "shared": true,
      "access": [
        {
          "email": "sam@example.com",
          "permission": "read_only"
        }
      ]
    }
  ],
  "accounts": [
    {
      "username": "sam",
      "name": "Sam",
      "role": "user",
      "passwordEnv": "PROV_PASSWORD"
    }
  ],
  "routing": [
    {
      "pattern": "*",
      "action": "forward",
      "forwardTo": "gerard.webb@ubuntudesign.com",
      "keepCopy": true,
      "mailbox": "support"
    },
    {
      "pattern": "no-reply",
      "action": "reject",
      "rejectReason": "No such user"
    }
  ],
  "mcpKeys": [
    {
      "name": "agent",
      "mailboxes": [
        "office"
      ],
      "scopes": [
        "mcp:read",
        "mcp:draft"
      ]
    }
  ],
  "push": {
    "to": "you@example.com"
  }
}
