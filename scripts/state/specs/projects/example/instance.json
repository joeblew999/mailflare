{
  "license": {
    "plan": "team"
  },
  "settings": {
    "appName": "Example Mail",
    "outboundAttachmentMaxMb": 25,
    "driveStorageLimitGb": 10,
    "assistant": {
      "enabled": true,
      "provider": "cloudflare"
    }
  },
  "backups": {
    "enabled": true,
    "schedule": "daily",
    "retentionDays": 30
  },
  "fresh": {
    "admin": {
      "email": "admin@example.com"
    }
  },
  "admin": {
    "preferences": {
      "timeZone": "Europe/Berlin"
    },
    "contacts": [
      {
        "email": "legal@partner.example",
        "name": "Legal"
      }
    ],
    "drive": {
      "folders": [
        "Policies"
      ]
    },
    "webhooks": [
      {
        "url": "https://hooks.partner.example/mail",
        "events": [
          "message.inbound",
          "message.failed"
        ],
        "description": "Partner CRM"
      }
    ]
  }
}
